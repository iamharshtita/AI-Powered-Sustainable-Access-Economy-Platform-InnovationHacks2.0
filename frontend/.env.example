# =============================================================================
# ReEarth — AI-Powered Sustainable Access Economy Platform
# Environment Variables Template
#
# Copy this file to .env.local and fill in your actual values.
#   cp .env.example .env.local
#
# ⚠️  NEVER commit .env.local to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Auth0 (Authentication)
# Get these from: https://manage.auth0.com → Applications → Your App → Settings
# -----------------------------------------------------------------------------

# A long random secret used to encrypt the session cookie (min 32 chars)
# Generate one with: openssl rand -hex 32
AUTH0_SECRET=your-random-secret-at-least-32-characters-long

# The base URL of your deployed app (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://your-amplify-domain.amplifyapp.com
AUTH0_BASE_URL=http://localhost:3000

# Your Auth0 tenant domain (found in Application Settings)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Your Auth0 application Client ID
AUTH0_CLIENT_ID=your-auth0-client-id

# Your Auth0 application Client Secret
AUTH0_CLIENT_SECRET=your-auth0-client-secret


# -----------------------------------------------------------------------------
# Stripe (Payments)
# Get these from: https://dashboard.stripe.com → Developers → API Keys
# Use sk_test_... / pk_test_... for test mode
# -----------------------------------------------------------------------------

# Server-side secret key (never expose this to the browser)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Client-side publishable key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key


# -----------------------------------------------------------------------------
# AWS (DynamoDB, S3, Bedrock, Secrets Manager)
# The IAM user/role must have access to DynamoDB, S3, and Bedrock in this region
# For Amplify: set these as environment variables in the Amplify Console instead
# -----------------------------------------------------------------------------

AWS_REGION=us-east-1

# Required for local development only (Amplify uses its own execution role in prod)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key


# -----------------------------------------------------------------------------
# ElevenLabs (Voice Text-to-Speech)
# Get your key from: https://elevenlabs.io → Profile → API Key
# In production, this is stored in AWS Secrets Manager automatically
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=your-elevenlabs-api-key


# -----------------------------------------------------------------------------
# AWS API Gateway (Backend REST API)
# This URL is output by `cdk deploy` — copy it from the terminal output:
#   SustainableAccessPlatformStack.ApiUrl = https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/prod
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod


# -----------------------------------------------------------------------------
# Optional Overrides (DynamoDB table names — defaults match CDK stack output)
# Only set these if you renamed the CDK stack or tables
# -----------------------------------------------------------------------------

# USERS_TABLE_NAME=SustainableAccessPlatformStack-Users
# ITEMS_TABLE_NAME=SustainableAccessPlatformStack-Items
# TRANSACTIONS_TABLE_NAME=SustainableAccessPlatformStack-Transactions
